# Copy this file to backup.env (same directory) and fill in real values.
# backup.env is git-ignored — never commit real credentials.

# --- Backblaze B2 / restic ---
# Create a dedicated B2 application key scoped to a single bucket used only for backups.
B2_ACCOUNT_ID=your-b2-key-id
B2_ACCOUNT_KEY=your-b2-application-key
RESTIC_REPOSITORY=b2:your-bucket-name:cmn-artist
# Encrypts the repo. Generate with `openssl rand -base64 32` and store it
# somewhere OTHER than this server (password manager) — if you lose it AND
# this file, the backups are unrecoverable.
RESTIC_PASSWORD=change-me-and-store-safely

# --- Paths on the host ---
# Directory containing docker-compose.yml
PROJECT_DIR=/opt/docker-apps/cmn_artist
# Host path bind-mounted into the app container at /media
MEDIA_DIR=/opt/docker-apps/cmn_artist/media
# Navidrome's data directory (contains navidrome.db)
NAVIDROME_DATA_DIR=/opt/docker-apps/navidrome/data

# --- Database credentials (must match docker-compose.yml) ---
DBUSER=admin
DBNAME=postgres
DBPASS=LocalPasswordOnly

# --- Retention (snapshots kept after each run) ---
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# --- Email notification (reuses the app's Gmail SMTP creds from its .env) ---
NOTIFY_EMAIL=you@example.com
EMAIL_HOST_USER=yourapp@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Capital Music Network <yourapp@gmail.com>
